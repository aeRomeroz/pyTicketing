@startuml CU25_ReactivarPlaza

skinparam linetype polyline

state reactivarPlaza as "reactivarPlaza(plaza)" {

    state " " as SolicitandoConfirmacion
    state " " as ProcesandoReactivacion

    [*] -[#green]-> SolicitandoConfirmacion
    note on link
    <b>Supervisor</b> solicita reactivar una plaza dada de baja
    end note

    SolicitandoConfirmacion -[#green]-> ProcesandoReactivacion
    note on link
    <b>Sistema</b> presenta la ficha de la plaza y advierte que la reactivación
    restaurará los vínculos suspendidos con sus máquinas y taquilleros
    • Permite solicitar confirmar reactivación
    • Permite solicitar cancelar operación
    end note

    ProcesandoReactivacion -[#green]-> [*]
    note on link
    <b>Supervisor</b> confirma la reactivación
    <b>Sistema</b> marca la plaza como activa, restaura los vínculos suspendidos y guarda cambios
    end note
}

reactivarPlaza -[#green]-> PLAZAS_ABIERTO
note on link
completarGestion()
end note

reactivarPlaza -[#blue]-> PLAZAS_ABIERTO
note on link
cancelar reactivación
end note

@enduml