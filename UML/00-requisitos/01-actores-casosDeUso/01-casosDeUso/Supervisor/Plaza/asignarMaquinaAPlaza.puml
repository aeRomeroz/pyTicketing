@startuml CU15_AsignarMaquinaAPlaza

skinparam linetype polyline

state asignarMaquinaAPlaza as "asignarMaquinaAPlaza(plaza)" {

    state " " as SolicitandoAsignacion
    state " " as ProcesandoAsignacion

    [*] -[#green]-> SolicitandoAsignacion
    note on link
    <b>Supervisor</b> solicita asignar una máquina a una plaza
    end note

    SolicitandoAsignacion -[#green]-> ProcesandoAsignacion
    note on link
    <b>Sistema</b> presenta la lista de máquinas activas disponibles y plazas
    • Permite seleccionar máquina y plaza a vincular
    • Permite solicitar confirmar asignación
    • Permite solicitar cancelar operación
    end note

    ProcesandoAsignacion -[#green]-> [*]
    note on link
    <b>Supervisor</b> confirma la asignación
    <b>Sistema</b> vincula la máquina con la plaza seleccionada y guarda cambios
    end note
}

asignarMaquinaAPlaza -[#green]-> PLAZAS_ABIERTO
note on link
completarGestion()
end note

asignarMaquinaAPlaza -[#blue]-> PLAZAS_ABIERTO
note on link
cancelar asignación
end note

@enduml