@startuml CU18_ConsultarPlaza

skinparam linetype polyline

state consultarPlaza as "consultarPlaza(plaza)" {

    state " " as RequiringConsultation
    state " " as ProvidingDetails
    state c <<choice>>

    [*] -[#green]-> RequiringConsultation
    note on link
    <b>Supervisor</b> solicita consultar plaza
    end note

    RequiringConsultation -[#green]-> ProvidingDetails
    note on link
    <b>Sistema</b> presenta
    • ficha detallada de la plaza (nombre, ciudad, estado, máquinas y taquilleros asignados)
    • opción para editar o volver al listado
    • mensaje si la plaza no existe
    end note

    ProvidingDetails -[#green]-> c
    note on link
    <b>Supervisor</b> solicita
    • continuar consultando
    • salir de consulta
    end note

    c -[#green]-> ProvidingDetails
    note on link
    continuar navegando
    end note

    c -[#green]-> [*]
    note on link
    salir de consulta
    end note
}

consultarPlaza -[#green]-> PLAZAS_ABIERTO
note on link
completarGestion()
end note

@enduml