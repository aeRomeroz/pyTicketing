@startuml CU11_RegistrarPlaza

skinparam linetype polyline

state registrarPlaza as "registrarPlaza()" {

    state " " as RequiringData
    state " " as ProvidingForm
    state " " as ValidatingData
    state c <<choice>>

    [*] -[#green]-> RequiringData
    note on link
    <b>Supervisor</b> solicita registrar una nueva plaza
    end note

    RequiringData -[#green]-> ProvidingForm
    note on link
    <b>Sistema</b> presenta el formulario de registro de plaza
    • Nombre, ciudad, estado
    end note

    ProvidingForm -[#green]-> ValidatingData
    note on link
    <b>Supervisor</b> ingresa los datos y solicita guardar
    end note

    ValidatingData -[#green]-> c
    note on link
    <b>Sistema</b> valida los datos ingresados
    end note

    c -[#red]-> ProvidingForm
    note on link
    datos inválidos o faltantes
    end note

    c -[#green]-> [*]
    note on link
    datos válidos, plaza registrada como activa y guardada
    end note
}

registrarPlaza -[#green]-> PLAZAS_ABIERTO
note on link
completarGestion()
end note

registrarPlaza -[#blue]-> PLAZAS_ABIERTO
note on link
cancelar registro
end note

@enduml