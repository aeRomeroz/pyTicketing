@startuml CU16_AsignarTaquilleroAPlaza

skinparam linetype polyline

state asignarTaquilleroAPlaza as "asignarTaquilleroAPlaza(plaza)" {

    state " " as SolicitandoAsignacion
    state " " as ProcesandoAsignacion

    [*] -[#green]-> SolicitandoAsignacion
    note on link
    <b>Supervisor</b> solicita asignar un taquillero a una plaza
    end note

    SolicitandoAsignacion -[#green]-> ProcesandoAsignacion
    note on link
    <b>Sistema</b> presenta la lista de taquilleros activos disponibles y plazas
    • Permite seleccionar taquillero y plaza a vincular
    • Permite solicitar confirmar asignación
    • Permite solicitar cancelar operación
    end note

    ProcesandoAsignacion -[#green]-> [*]
    note on link
    <b>Supervisor</b> confirma la asignación
    <b>Sistema</b> vincula el taquillero con la plaza seleccionada y guarda cambios
    end note
}

asignarTaquilleroAPlaza -[#green]-> PLAZAS_ABIERTO
note on link
completarGestion()
end note

asignarTaquilleroAPlaza -[#blue]-> PLAZAS_ABIERTO
note on link
cancelar asignación
end note

@enduml