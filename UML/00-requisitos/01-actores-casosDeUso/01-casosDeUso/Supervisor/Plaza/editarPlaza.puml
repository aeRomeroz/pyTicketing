@startuml CU19_EditarPlaza

skinparam linetype polyline

state editarPlaza as "editarPlaza(plaza)" {

    state " " as RequiringData
    state " " as ProvidingForm
    state " " as ValidatingData
    state c <<choice>>

    [*] -[#green]-> RequiringData
    note on link
    <b>Supervisor</b> solicita editar una plaza existente
    end note

    RequiringData -[#green]-> ProvidingForm
    note on link
    <b>Sistema</b> presenta formulario con datos precargados
    • Nombre, ciudad, estado
    end note

    ProvidingForm -[#green]-> ValidatingData
    note on link
    <b>Supervisor</b> modifica los datos y solicita guardar
    end note

    ValidatingData -[#green]-> c
    note on link
    <b>Sistema</b> valida los datos ingresados
    end note

    c -[#red]-> ProvidingForm
    note on link
    datos inválidos
    end note

    c -[#green]-> [*]
    note on link
    datos válidos y guardados
    end note
}

editarPlaza -[#green]-> PLAZAS_ABIERTO
note on link
completarGestion()
end note

editarPlaza -[#blue]-> PLAZAS_ABIERTO
note on link
cancelar edición
end note

@enduml