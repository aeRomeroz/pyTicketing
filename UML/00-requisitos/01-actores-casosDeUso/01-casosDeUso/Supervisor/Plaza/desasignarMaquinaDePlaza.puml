@startuml CU22_DesasignarMaquinaDePlaza

skinparam linetype polyline

state desasignarMaquinaDePlaza as "desasignarMaquinaDePlaza(plaza)" {

    state " " as SolicitandoConfirmacion
    state " " as ProcesandoDesasignacion

    [*] -[#green]-> SolicitandoConfirmacion
    note on link
    <b>Supervisor</b> solicita desasignar una máquina de su plaza actual
    end note

    SolicitandoConfirmacion -[#green]-> ProcesandoDesasignacion
    note on link
    <b>Sistema</b> presenta la ficha de la máquina con su plaza asignada actual
    • Muestra advertencia de que la máquina quedará sin plaza asignada
    • Permite solicitar confirmar desasignación
    • Permite solicitar cancelar operación
    end note

    ProcesandoDesasignacion -[#green]-> [*]
    note on link
    <b>Supervisor</b> confirma la desasignación
    <b>Sistema</b> desvincula la máquina de su plaza actual, actualiza su estado a disponible y guarda cambios
    end note
}

desasignarMaquinaDePlaza -[#green]-> PLAZAS_ABIERTO
note on link
completarGestion()
end note

desasignarMaquinaDePlaza -[#blue]-> PLAZAS_ABIERTO
note on link
cancelar desasignación
end note

@enduml