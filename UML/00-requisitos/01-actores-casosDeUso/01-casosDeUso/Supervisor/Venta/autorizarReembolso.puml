@startuml CU06_AutorizarReembolso

skinparam linetype polyline

state autorizarReembolso as "autorizarReembolso(reembolso)" {

    state " " as RequiringAction
    state " " as ProvidingDetails
    state " " as ValidatingRejection
    state c <<choice>>

    [*] -[#green]-> RequiringAction
    note on link
    <b>Supervisor</b> solicita revisar un reembolso pendiente
    end note

    RequiringAction -[#green]-> ProvidingDetails
    note on link
    <b>Sistema</b> presenta detalle del reembolso (venta original, monto, motivo de anulación)
    • Permite solicitar aprobar reembolso
    • Permite solicitar rechazar reembolso (requiere motivo)
    end note

    ProvidingDetails -[#green]-> [*]
    note on link
    <b>Supervisor</b> aprueba el reembolso
    <b>Sistema</b> marca el reembolso como aprobado, notifica al Taquillero para la devolución y guarda cambios
    end note

    ProvidingDetails -[#red]-> ValidatingRejection
    note on link
    <b>Supervisor</b> rechaza el reembolso e ingresa motivo
    end note

    ValidatingRejection -[#red]-> c
    note on link
    <b>Sistema</b> valida que el motivo de rechazo no esté vacío
    end note

    c -[#red]-> ProvidingDetails
    note on link
    motivo de rechazo inválido o vacío
    end note

    c -[#green]-> [*]
    note on link
    motivo válido, reembolso marcado como rechazado, notificado al Taquillero y guardado
    end note
}

autorizarReembolso -[#green]-> VENTAS_ABIERTO
note on link
completarGestion()
end note

autorizarReembolso -[#blue]-> VENTAS_ABIERTO
note on link
cancelar revisión
end note

@enduml