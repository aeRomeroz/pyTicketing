@startuml CU04_RevisarCierreDeCaja

skinparam linetype polyline

state revisarCierreDeCaja as "revisarCierreDeCaja(cierre)" {

    state " " as RequiringAction
    state " " as ProvidingDetails
    state " " as ValidatingReturn
    state c <<choice>>

    [*] -[#green]-> RequiringAction
    note on link
    <b>Supervisor</b> solicita revisar un cierre de caja consolidado
    end note

    RequiringAction -[#green]-> ProvidingDetails
    note on link
    <b>Sistema</b> presenta resumen del día (ventas, reembolsos y reportes)
    • Permite solicitar aprobar cierre directamente
    • Permite solicitar editar cierre (corregir datos y observaciones)
    • Permite solicitar devolver al taquillero (requiere motivo)
    end note

    ProvidingDetails -[#green]-> [*]
    note on link
    <b>Supervisor</b> aprueba o guarda ediciones y aprueba el cierre
    <b>Sistema</b> marca el cierre como APROBADO, cierra el ciclo del día y guarda cambios
    end note

    ProvidingDetails -[#red]-> ValidatingReturn
    note on link
    <b>Supervisor</b> solicita devolver al taquillero e ingresa motivo
    end note

    ValidatingReturn -[#red]-> c
    note on link
    <b>Sistema</b> valida que el motivo de devolución no esté vacío
    end note

    c -[#red]-> ProvidingDetails
    note on link
    motivo de devolución inválido o vacío
    end note

    c -[#green]-> [*]
    note on link
    motivo válido, cierre marcado como DEVUELTO/RECHAZADO, notificado al Taquillero y guardado
    end note
}

revisarCierreDeCaja -[#green]-> CAJA_ABIERTA
note on link
completarGestion()
end note

revisarCierreDeCaja -[#blue]-> CAJA_ABIERTA
note on link
cancelar revisión
end note

@enduml