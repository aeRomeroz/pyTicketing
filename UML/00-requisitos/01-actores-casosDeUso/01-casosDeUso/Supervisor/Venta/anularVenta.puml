@startuml CU02_AnularVenta

skinparam linetype polyline

state anularVenta as "anularVenta(venta)" {

    state " " as RequiringReason
    state " " as ProvidingForm
    state " " as ValidatingData
    state c <<choice>>

    [*] -[#green]-> RequiringReason
    note on link
    <b>Taquillero/Supervisor</b> solicita anular una venta registrada
    end note

    RequiringReason -[#green]-> ProvidingForm
    note on link
    <b>Sistema</b> presenta detalle de la venta (máquina, tickets, total, método de pago)
    • Solicita motivo de anulación (obligatorio)
    end note

    ProvidingForm -[#green]-> ValidatingData
    note on link
    <b>Usuario</b> ingresa motivo y solicita confirmar anulación
    end note

    ValidatingData -[#green]-> c
    note on link
    <b>Sistema</b> valida que el motivo no esté vacío
    end note

    c -[#red]-> ProvidingForm
    note on link
    motivo inválido o vacío
    end note

    c -[#green]-> [*]
    note on link
    motivo válido, venta anulada, reembolso generado en estado pendiente y guardado
    end note
}

anularVenta -[#green]-> VENTAS_ABIERTO
note on link
completarGestion()
end note

anularVenta -[#blue]-> VENTAS_ABIERTO
note on link
cancelar anulación
end note

@enduml