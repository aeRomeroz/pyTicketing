@startuml CU26_ReactivarMaquina

skinparam linetype polyline

state reactivarMaquina as "reactivarMaquina(maquina)" {

    state " " as SolicitandoConfirmacion
    state " " as ProcesandoReactivacion

    [*] -[#green]-> SolicitandoConfirmacion
    note on link
    <b>Supervisor</b> solicita reactivar una máquina dada de baja
    end note

    SolicitandoConfirmacion -[#green]-> ProcesandoReactivacion
    note on link
    <b>Sistema</b> presenta la ficha de la máquina y advierte que la reactivación
    restaurará los vínculos suspendidos con su plaza y motorario
    • Permite solicitar confirmar reactivación
    • Permite solicitar cancelar operación
    end note

    ProcesandoReactivacion -[#green]-> [*]
    note on link
    <b>Supervisor</b> confirma la reactivación
    <b>Sistema</b> marca la máquina como activa, restaura los vínculos suspendidos y guarda cambios
    end note
}

reactivarMaquina -[#green]-> MAQUINAS_ABIERTO
note on link
completarGestion()
end note

reactivarMaquina -[#blue]-> MAQUINAS_ABIERTO
note on link
cancelar reactivación
end note

@enduml