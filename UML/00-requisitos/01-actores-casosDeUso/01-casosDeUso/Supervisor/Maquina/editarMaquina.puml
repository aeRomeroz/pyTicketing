@startuml CU21_EditarMaquina

skinparam linetype polyline

state editarMaquina as "editarMaquina(maquina)" {

    state " " as RequiringData
    state " " as ProvidingForm
    state " " as ValidatingData
    state c <<choice>>

    [*] -[#green]-> RequiringData
    note on link
    <b>Supervisor</b> solicita editar una máquina existente
    end note

    RequiringData -[#green]-> ProvidingForm
    note on link
    <b>Sistema</b> presenta formulario con datos precargados
    • Nombre, tipoRestriccion
    • Configuración de tipos de ticket (Niño / Adulto) y precios
    end note

    ProvidingForm -[#green]-> ValidatingData
    note on link
    <b>Supervisor</b> modifica los datos y solicita guardar
    end note

    ValidatingData -[#green]-> c
    note on link
    <b>Sistema</b> valida los datos ingresados y que al menos un tipo de ticket esté definido
    end note

    c -[#red]-> ProvidingForm
    note on link
    datos inválidos
    end note

    c -[#green]-> [*]
    note on link
    datos válidos y guardados
    end note
}

editarMaquina -[#green]-> MAQUINAS_ABIERTO
note on link
completarGestion()
end note

editarMaquina -[#blue]-> MAQUINAS_ABIERTO
note on link
cancelar edición
end note

@enduml