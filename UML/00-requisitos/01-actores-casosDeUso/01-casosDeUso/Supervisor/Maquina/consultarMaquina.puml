@startuml CU20_ConsultarMaquina

skinparam linetype polyline

state consultarMaquina as "consultarMaquina(maquina)" {

    state " " as RequiringConsultation
    state " " as ProvidingDetails
    state c <<choice>>

    [*] -[#green]-> RequiringConsultation
    note on link
    <b>Supervisor / Motorario</b> solicita consultar máquina
    end note

    RequiringConsultation -[#green]-> ProvidingDetails
    note on link
    <b>Sistema</b> presenta
    • ficha detallada de la máquina (nombre, tipoRestriccion, tipos de ticket, plaza, motorario)
    • opción para editar o volver al listado
    • mensaje si la máquina no existe
    end note

    ProvidingDetails -[#green]-> c
    note on link
    <b>Supervisor / Motorario</b> solicita
    • continuar consultando
    • salir de consulta
    end note

    c -[#green]-> ProvidingDetails
    note on link
    continuar navegando
    end note

    c -[#green]-> [*]
    note on link
    salir de consulta
    end note
}

consultarMaquina -[#green]-> MAQUINAS_ABIERTO
note on link
completarGestion()
end note

@enduml