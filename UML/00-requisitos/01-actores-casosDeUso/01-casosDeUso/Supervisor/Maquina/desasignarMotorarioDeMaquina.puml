@startuml CU24_DesasignarMotorarioDeMaquina
title Desasignar Motorario de Máquina
skinparam nodesep 100
skinparam ranksep 100
skinparam linetype ortho
skinparam Padding 10

state MAQUINAS_ABIERTO_INICIAL as "MAQUINAS_ABIERTO"
state ASIGNACION_ABIERTA as "ASIGNACION_ABIERTA"
state MAQUINAS_ABIERTO_FINAL as "MAQUINAS_ABIERTO"

[*] -[#green]-> MAQUINAS_ABIERTO_INICIAL

MAQUINAS_ABIERTO_INICIAL -[#green]-> ASIGNACION_ABIERTA : desasignarMotorarioDeMaquina()
note left on link
    <b>Supervisor solicita</b> desasignar un motorario
    de su máquina actual.
    <b>Sistema presenta</b> la ficha del motorario
    con su máquina asignada actual.
end note

state ASIGNACION_ABIERTA {
    state VisualizacionAsignacion as "Visualización de Asignación"
    state ConfirmacionDesasignacion as "Confirmación de Desasignación"

    [*] -[#green]-> VisualizacionAsignacion
    note right of VisualizacionAsignacion
        <b>Sistema muestra</b> el motorario y su
        máquina asignada actual.
        <b>Sistema advierte</b> que el motorario
        quedará sin máquina asignada.
        <b>Supervisor puede solicitar</b> confirmar
        mediante ejecutarDesasignacion().
    end note

    VisualizacionAsignacion -[#green]-> ConfirmacionDesasignacion : ejecutarDesasignacion()
    note right of ConfirmacionDesasignacion
        <b>Sistema desvincula</b> el motorario
        de su máquina actual.
        <b>Sistema marca</b> el motorario como
        disponible para nueva asignación.
    end note

    ConfirmacionDesasignacion -[#green]-> [*]
}

ASIGNACION_ABIERTA -[#green]-> MAQUINAS_ABIERTO_FINAL : confirmarDesasignacion()
note left on link
    <b>Sistema confirma</b> la desasignación realizada
    y regresa al listado de máquinas.
end note

ASIGNACION_ABIERTA -[#red]-> MAQUINAS_ABIERTO_FINAL : cancelarDesasignacion()
note right on link
    <b>CANCELAR:</b>
    <b>Supervisor solicita</b> cancelar la operación.
    <b>Sistema mantiene</b> el vínculo actual
    y regresa al listado de máquinas.
end note

MAQUINAS_ABIERTO_FINAL -[#blue]-> [*]

@enduml