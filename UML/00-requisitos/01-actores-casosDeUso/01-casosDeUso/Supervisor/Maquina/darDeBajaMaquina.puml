@startuml CU14_DarDeBajaMaquina

skinparam linetype polyline

state darDeBajaMaquina as "darDeBajaMaquina(maquina)" {

    state " " as SolicitandoConfirmacion
    state " " as ProcesandoBaja

    [*] -[#green]-> SolicitandoConfirmacion
    note on link
    <b>Supervisor</b> solicita dar de baja una máquina existente
    end note

    SolicitandoConfirmacion -[#green]-> ProcesandoBaja
    note on link
    <b>Sistema</b> presenta la ficha de la máquina y advierte que la baja
    suspenderá el vínculo con su plaza y motorario asignados
    • Permite solicitar confirmar baja
    • Permite solicitar cancelar operación
    end note

    ProcesandoBaja -[#green]-> [*]
    note on link
    <b>Supervisor</b> confirma la baja
    <b>Sistema</b> marca la máquina como inactiva, suspende los vínculos asignados y guarda cambios
    end note
}

darDeBajaMaquina -[#green]-> MAQUINAS_ABIERTO
note on link
completarGestion()
end note

darDeBajaMaquina -[#blue]-> MAQUINAS_ABIERTO
note on link
cancelar baja
end note

@enduml