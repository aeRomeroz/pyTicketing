@startuml CU09_EditarUsuario

skinparam linetype polyline

state editarUsuario as "editarUsuario(usuario)" {

    state " " as SolicitandoEdicion
    state " " as EditandoUsuario

    [*] -[#green]-> SolicitandoEdicion
    note on link
    <b>Administrador / Usuario</b> solicita editar los datos de un usuario existente
    end note

    SolicitandoEdicion -[#green]-> EditandoUsuario
    note on link
    <b>Sistema</b> presenta formulario con los datos actuales precargados
    • Nombre de usuario (modificable)
    • Contraseña (modificable)
    • Rol asignado (modificable solo por Administrador)
    • Permite solicitar guardar cambios
    • Permite solicitar cancelar edición
    end note

    EditandoUsuario -[#green]-> [*]
    note on link
    <b>Administrador / Usuario</b> proporciona los datos modificados
    <b>Sistema</b> valida los datos, registra los cambios y transfiere a consulta
    end note
}

editarUsuario -[#green]-> USUARIO_ABIERTO
note on link
consultarUsuario(usuarioModificado)
end note

editarUsuario -[#red]-> USUARIOS_ABIERTO
note on link
cancelar edición
end note

@enduml