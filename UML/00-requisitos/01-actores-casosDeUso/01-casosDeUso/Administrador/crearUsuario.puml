@startuml CU07_CrearUsuario

skinparam linetype polyline

state crearUsuario as "crearUsuario()" {

    state " " as SolicitandoDatos
    state " " as CreandoUsuario

    [*] -[#green]-> SolicitandoDatos 
    note on link
    <b>Administrador</b> solicita crear usuario nuevo
    end note    
    
    SolicitandoDatos -[#green]-> CreandoUsuario
    note on link
    <b>Sistema</b> presenta formulario de datos mínimos del usuario
    • Nombre de usuario (obligatorio)
    • Contraseña (obligatoria)
    • Rol asignado (obligatorio)
    • Permite solicitar crear usuario
    • Permite solicitar cancelar creación
    end note
    
    CreandoUsuario -[#green]-> [*]
    note on link
    <b>Administrador</b> proporciona datos requeridos
    <b>Sistema</b> valida datos, crea el usuario y transfiere a edición
    end note
}

crearUsuario -[#green]-> USUARIO_ABIERTO
note on link
editarUsuario(usuarioNuevo)
end note

crearUsuario -[#red]-> USUARIOS_ABIERTO
note on link
cancelar creación
end note

@enduml