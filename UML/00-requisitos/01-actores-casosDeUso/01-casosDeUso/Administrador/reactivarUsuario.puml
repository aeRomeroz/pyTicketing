@startuml CU27_ReactivarUsuario

skinparam linetype polyline

state reactivarUsuario as "reactivarUsuario(usuario)" {

    state " " as SolicitandoConfirmacion
    state " " as ReactivandoUsuario

    [*] -[#green]-> SolicitandoConfirmacion
    note on link
    <b>Administrador</b> solicita reactivar a un usuario inactivo del listado
    end note

    SolicitandoConfirmacion -[#green]-> ReactivandoUsuario
    note on link
    <b>Sistema</b> presenta la ficha del usuario inactivo
    • Datos del usuario (solo lectura)
    • Estado actual: Inactivo
    • Mensaje explicativo (se restaurará su acceso al sistema con su rol asignado)
    • Permite solicitar confirmar reactivación
    • Permite solicitar cancelar operación
    end note

    ReactivandoUsuario -[#green]-> [*]
    note on link
    <b>Administrador</b> confirma la reactivación
    <b>Sistema</b> marca el usuario como activo, restaura sus permisos y guarda cambios
    end note
}

reactivarUsuario -[#green]-> USUARIOS_ABIERTO
note on link
completarGestion()
end note

reactivarUsuario -[#blue]-> USUARIOS_ABIERTO
note on link
cancelar reactivación
end note

@enduml