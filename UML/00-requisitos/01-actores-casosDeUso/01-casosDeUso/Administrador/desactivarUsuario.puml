@startuml CU10_DesactivarUsuario

skinparam linetype polyline

state desactivarUsuario as "desactivarUsuario(usuario)" {

    state " " as SolicitandoConfirmacion
    state " " as DesactivandoUsuario

    [*] -[#green]-> SolicitandoConfirmacion
    note on link
    <b>Administrador</b> solicita desactivar a un usuario del listado
    end note

    SolicitandoConfirmacion -[#green]-> DesactivandoUsuario
    note on link
    <b>Sistema</b> presenta la ficha del usuario con advertencia
    • Datos del usuario (solo lectura)
    • Estado actual: Activo
    • Mensaje de advertencia (impedirá el acceso al sistema)
    • Permite solicitar confirmar desactivación
    • Permite solicitar cancelar operación
    end note

    DesactivandoUsuario -[#green]-> [*]
    note on link
    <b>Administrador</b> confirma la desactivación
    <b>Sistema</b> marca el usuario como inactivo, cierra sus sesiones activas y guarda cambios
    end note
}

desactivarUsuario -[#green]-> USUARIOS_ABIERTO
note on link
desactivación confirmada
end note

desactivarUsuario -[#red]-> USUARIOS_ABIERTO
note on link
cancelar desactivación
end note

@enduml