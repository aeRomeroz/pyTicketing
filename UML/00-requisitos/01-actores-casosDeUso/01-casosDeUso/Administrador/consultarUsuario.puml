@startuml CU08_ConsultarUsuario

skinparam linetype polyline

state consultarUsuario as "consultarUsuario(usuario)" {

    state " " as PresentandoDetalle

    [*] -[#green]-> PresentandoDetalle
    note on link
    <b>Administrador</b> selecciona un usuario del listado para consultar
    end note
    
    PresentandoDetalle -[#green]-> [*]
    note on link
    <b>Sistema</b> presenta la ficha detallada del usuario
    • Nombre de usuario (solo lectura)
    • Rol asignado (solo lectura)
    • Estado: Activo / Inactivo (solo lectura)
    • Permite solicitar editar usuario
    • Permite solicitar cerrar/volver
    end note
}

consultarUsuario -[#green]-> USUARIO_ABIERTO
note on link
editarUsuario(usuario)
end note

consultarUsuario -[#blue]-> USUARIOS_ABIERTO
note on link
cerrar / volver
end note

@enduml