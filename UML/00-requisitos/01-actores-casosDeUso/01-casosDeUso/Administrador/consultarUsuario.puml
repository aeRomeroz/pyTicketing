@startuml CU08_ConsultarUsuario

skinparam linetype polyline

state consultarUsuario as "consultarUsuario(usuario)" {

    state " " as RequiringConsultation
    state " " as ProvidingDetails
    state c <<choice>>

    [*] -[#green]-> RequiringConsultation
    note on link
    <b>Administrador</b> solicita consultar usuario
    end note

    RequiringConsultation -[#green]-> ProvidingDetails
    note on link
    <b>Sistema</b> presenta
    • ficha detallada del usuario (nombre, rol, estado)
    • opción para editar o volver al listado
    • mensaje si el usuario no existe
    end note

    ProvidingDetails -[#green]-> c
    note on link
    <b>Administrador</b> solicita
    • continuar consultando
    • salir de consulta
    end note

    c -[#green]-> ProvidingDetails
    note on link
    continuar navegando
    end note

    c -[#green]-> [*]
    note on link
    salir de consulta
    end note
}

consultarUsuario -[#green]-> USUARIOS_ABIERTO
note on link
completarGestion()
end note

@enduml