@startuml CU05_ReportarTicketsRecibidos

skinparam linetype polyline

state reportarTicketsRecibidos as "reportarTicketsRecibidos(maquina)" {

    state " " as RequiringRegistration
    state " " as ProvidingConfirmation
    state c <<choice>>

    [*] -[#green]-> RequiringRegistration
    note on link
    <b>Motorario</b> solicita registrar entrada de grupo/familia
    end note

    RequiringRegistration -[#green]-> ProvidingConfirmation
    note on link
    <b>Sistema</b> presenta
    • contadores de grupo (+/- Niño / Adulto / Total)
    • histórico de lecturas del turno
    • total acumulado de la jornada
    end note

    ProvidingConfirmation -[#green]-> c
    note on link
    <b>Motorario</b> solicita
    • guardar lectura parcial
    • cancelar lectura
    end note

    c -[#red]-> [*]
    note on link
    Motorario cancela
    end note

    c -[#green]-> [*]
    note on link
    registro exitoso
    end note
}

reportarTicketsRecibidos -[#green]-> REPORTE_ABIERTO
note on link
continuar lecturas
end note

reportarTicketsRecibidos -[#red]-> REPORTE_ABIERTO
note on link
cancelar lectura
end note

@enduml