@startuml CU02_SolicitarAnulacionVenta

skinparam linetype polyline

state solicitarAnulacionVenta as "solicitarAnulacionVenta(venta)" {

    state " " as RequiringReason
    state " " as ProvidingForm
    state " " as ValidatingData
    state c <<choice>>

    [*] -[#green]-> RequiringReason
    note on link
    <b>Taquillero</b> solicita anular una venta de su turno
    end note

    RequiringReason -[#green]-> ProvidingForm
    note on link
    <b>Sistema</b> presenta el detalle de la venta (tickets, total, método de pago)
    • Solicita motivo de la anulación (obligatorio)
    end note

    ProvidingForm -[#green]-> ValidatingData
    note on link
    <b>Taquillero</b> ingresa el motivo y confirma la solicitud
    end note

    ValidatingData -[#green]-> c
    note on link
    <b>Sistema</b> valida que el motivo no esté vacío
    end note

    c -[#red]-> ProvidingForm
    note on link
    motivo inválido o vacío
    end note

    c -[#green]-> [*]
    note on link
    motivo válido, venta marcada como PENDIENTE_ANULACION y notificado al Supervisor
    end note
}

solicitarAnulacionVenta -[#green]-> VENTAS_ABIERTO
note on link
completarGestion()
end note

solicitarAnulacionVenta -[#blue]-> VENTAS_ABIERTO
note on link
cancelar solicitud
end note

@enduml