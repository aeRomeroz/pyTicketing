@startuml CU01_RegistrarVenta

skinparam linetype polyline

state registrarVenta as "registrarVenta()" {

    state " " as RequiringAction
    state " " as ProvidingForm
    state " " as ValidatingData
    state c <<choice>>

    [*] -[#green]-> RequiringAction
    note on link
    <b>Taquillero</b> solicita registrar una nueva venta
    end note

    RequiringAction -[#green]-> ProvidingForm
    note on link
    <b>Sistema</b> presenta máquinas activas de la plaza y formulario de venta
    • Permite seleccionar máquina y tipos/cantidad de tickets (niño/adulto)
    • Muestra total calculado en tiempo real
    • Permite seleccionar método de pago
    end note

    ProvidingForm -[#green]-> ValidatingData
    note on link
    <b>Taquillero</b> confirma los datos ingresados y solicita procesar venta
    end note

    ValidatingData -[#green]-> c
    note on link
    <b>Sistema</b> valida disponibilidad de tickets, máquina activa y método de pago
    end note

    c -[#red]-> ProvidingForm
    note on link
    datos de venta inválidos o incompletos
    end note

    c -[#green]-> [*]
    note on link
    datos válidos, venta registrada, tickets emitidos y guardados
    end note
}

registrarVenta -[#green]-> VENTAS_ABIERTO
note on link
completarGestion()
end note

registrarVenta -[#blue]-> VENTAS_ABIERTO
note on link
cancelar venta
end note

@enduml