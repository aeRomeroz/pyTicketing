@startuml
skinparam linetype polyline

state completarGestion as "completarGestion()" {

    state " " as PresentandoMenu
    state " " as EsperandoSeleccion

    [*] -[#green]-> PresentandoMenu 
    note on link
    <b>Usuario</b> solicita disponibilizar sistema
    end note    
    
    PresentandoMenu -[#green]-> EsperandoSeleccion
    note on link
    <b>Sistema</b> permite solicitar:
    • abrirMaquinas()
    • abrirPlazas()
    • abrirUsuarios()
    • abrirReportes()
    • abrirCaja()
    • abrirVentas()
    • cerrarSesion()
    end note
    
    EsperandoSeleccion -[#green]-> [*]
    note on link
    <b>Usuario</b> solicita una de las opciones
    end note
}

completarGestion -[#green]-> MAQUINAS_ABIERTO
note on link
abrirMaquinas()
end note

completarGestion -[#green]-> PLAZAS_ABIERTO
note on link
abrirPlazas()
end note

completarGestion -[#green]-> USUARIOS_ABIERTO
note on link
abrirUsuarios()
end note

completarGestion -[#green]-> REPORTES_ABIERTO
note on link
abrirReportes()
end note

completarGestion -[#green]-> CAJA_ABIERTA
note on link
abrirCaja()
end note

completarGestion -[#green]-> VENTAS_ABIERTO
note on link
abrirVentas()
end note

completarGestion -[#green]-> SESION_CERRADA
note on link
cerrarSesion()
end note
@enduml