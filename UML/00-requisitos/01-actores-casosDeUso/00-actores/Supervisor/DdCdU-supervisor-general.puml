@startuml DdCdU-supervisor-general

left to right direction

actor "Supervisor" as supervisor

package "Módulo: Gestión de Máquinas" {
    usecase registrarMaquina as "registrarMaquina()"
    usecase consultarMaquina as "consultarMaquina()"
    usecase editarMaquina as "editarMaquina()"
    usecase darDeBajaMaquina as "darDeBajaMaquina()"
    usecase reactivarMaquina as "reactivarMaquina()"

    usecase asignarMotorarioAMaquina as "asignarMotorarioAMaquina()"
    usecase desasignarMotorarioDeMaquina as "desasignarMotorarioDeMaquina()"
}

package "Módulo: Gestión de Plazas" {
    usecase registrarPlaza as "registrarPlaza()"
    usecase consultarPlaza as "consultarPlaza()"
    usecase editarPlaza as "editarPlaza()"
    usecase darDeBajaPlaza as "darDeBajaPlaza()"
    usecase reactivarPlaza as "reactivarPlaza()"

    usecase asignarMaquinaAPlaza as "asignarMaquinaAPlaza()"
    usecase desasignarMaquinaDePlaza as "desasignarMaquinaDePlaza()"

    usecase asignarTaquilleroAPlaza as "asignarTaquilleroAPlaza()"
    usecase desasignarTaquilleroDePlaza as "desasignarTaquilleroDePlaza()"
}

package "Módulo: Gestión de Ventas y Caja" {
    usecase anularVenta as "anularVenta()"
    usecase autorizarReembolso as "autorizarReembolso()"
    usecase revisarCierreDeCaja as "revisarCierreDeCaja()"
    usecase consolidarCierreDeCaja as "consolidarCierreDeCaja()"
}

' --- Conexiones Gestión de Máquinas ---
supervisor --> registrarMaquina
supervisor --> consultarMaquina
supervisor --> editarMaquina
supervisor --> darDeBajaMaquina
supervisor --> reactivarMaquina
supervisor --> asignarMotorarioAMaquina
supervisor --> desasignarMotorarioDeMaquina

' --- Conexiones Gestión de Plazas ---
supervisor --> registrarPlaza
supervisor --> consultarPlaza
supervisor --> editarPlaza
supervisor --> darDeBajaPlaza
supervisor --> reactivarPlaza
supervisor --> asignarMaquinaAPlaza
supervisor --> desasignarMaquinaDePlaza
supervisor --> asignarTaquilleroAPlaza
supervisor --> desasignarTaquilleroDePlaza

' --- Conexiones Gestión de Ventas y Caja ---
supervisor --> anularVenta
supervisor --> autorizarReembolso
supervisor --> revisarCierreDeCaja
supervisor --> consolidarCierreDeCaja

@enduml